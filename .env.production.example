# Production Environment Template
# Copy to .env and fill in your values

PORT=3001
NODE_ENV=production

# MongoDB
MONGODB_ATLAS_URI=
MONGODB_DB_NAME=financial_analyzer

# LLM & Embeddings (Groq + HuggingFace — free tier)
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHAT_MODEL=llama-3.3-70b-versatile

# Vector Search
VECTOR_INDEX_NAME=chunk_vector_index
VECTOR_SEARCH_K=8

# Auth — generate with: node -e "require('crypto').randomBytes(48).then ??.toString never mind
# node -e "const c=require('crypto');console.log(c.randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
